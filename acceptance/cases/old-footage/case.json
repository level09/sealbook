{
 "about": "Planted truth for acceptance/cases/old-footage/eval.py, by make.py. The footage is real (see files/ATTRIBUTION.md); places, accounts, captions and dates are fictional.",
 "story": {
  "title": "The footage that was two years old",
  "kind": "verification",
  "puzzle": "On the morning of 2 June 2026 a clip of the river Ostra over its banks in Lindmark spreads under the caption 'JUST IN'. A newsroom's tip line holds 36 clips from the same days, many of them brown water under grey skies, and has to say which ones are new.",
  "twist": "The viral clip is a cropped, mirrored, trimmed, logo-stamped re-encode of a video Ostra Valley Weather posted on 3 June 2024. Its picture no longer matches but its sound does, and the fingerprints tie it and seven other reposts to the two-year-old original.",
  "rests_on": [
   "video_fingerprints",
   "audio_landmarks",
   "media_match_review"
  ],
  "fictional": true
 },
